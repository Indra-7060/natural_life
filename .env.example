#--------------------------------------------------------------------
# Sugarlif / Natural Life — environment configuration (EXAMPLE)
# Copy this file to ".env" and fill in the values. Never commit ".env".
#--------------------------------------------------------------------

CI_ENVIRONMENT = development        # use "production" on the live server

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.appTimezone = 'Asia/Kolkata'
# app.forceGlobalSecureRequests = true   # enable on the live HTTPS server

encryption.key =                    # generate with: php spark key:generate

#--------------------------------------------------------------------
# DATABASE (XAMPP default: root with an empty password)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = sugarlif_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# FIRST ADMIN ACCOUNT (used once by "php spark db:seed DatabaseSeeder")
# Choose your own password here before seeding. You are asked to change
# it at first login. These two lines can be deleted after seeding.
#--------------------------------------------------------------------
admin.defaultName = 'Site Administrator'
admin.defaultEmail = 'admin@natural-life.in'
admin.defaultPassword = 'change-me-before-seeding'

#--------------------------------------------------------------------
# CCAVENUE PAYMENT GATEWAY (credentials from the CCAvenue merchant panel)
# Leave empty until the client supplies them: orders are then saved as
# "pending payment" and are never marked paid automatically.
#--------------------------------------------------------------------
ccavenue.merchantId =
ccavenue.accessCode =
ccavenue.workingKey =
ccavenue.mode = test                # "test" or "live"

#--------------------------------------------------------------------
# E-MAIL (SMTP). Leave SMTPHost empty to write e-mails to
# writable/emails/ instead of sending them (useful on XAMPP).
#--------------------------------------------------------------------
email.fromEmail = 'no-reply@natural-life.in'
email.fromName = 'Sugarlif'
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
